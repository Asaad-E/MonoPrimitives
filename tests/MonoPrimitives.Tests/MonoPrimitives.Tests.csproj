<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a normal xunit/nunit project: PrimitiveBatch/Primitive3DBatch both need a real
    GraphicsDevice (BasicEffect, DrawUserPrimitives), and MonoGame only creates one inside
    a running Game. So this is a small headless Game that runs every shape-generation test
    once in Draw(), then exits with a process exit code (0 = all passed, 1 = a test failed)
    — run it like any other console app, not through a test runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MonoPrimitives.csproj" />
  </ItemGroup>

</Project>
