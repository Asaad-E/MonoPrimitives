<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One assembly, raylib/MonoGame.Extended-style: 2D, 3D, and the shared Core pieces all live
    here (see the Core/, 2D/, 3D/ subfolders — same source, still organized the same way, just
    compiled into one DLL instead of three). Namespaces are unified under one root
    (MonoPrimitives, MonoPrimitives.Primitives2D, MonoPrimitives.Primitives3D — see
    DECISIONS.md) — nothing about how you reference a type changes based on assembly count,
    only how many separate packages you needed to install to get it.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet metadata -->
  <PropertyGroup>
    <PackageId>MonoPrimitives</PackageId>
    <Version>0.8.2</Version>
    <Authors>Asaad-E</Authors>
    <Description>Immediate-mode 2D and 3D primitive drawing for MonoGame, plus the small set of helpers a fast prototype usually needs — camera, input, easing, color, noise, and collision/raycast tests — in one package.</Description>
    <PackageTags>monogame;2d;3d;primitives;drawing;prototyping</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Asaad-E/MonoPrimitives</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Asaad-E/MonoPrimitives</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Repo root README, not src/'s own — bundled into the .nupkg so nuget.org stops flagging it as missing. -->
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
